[Unit]
Description=Gracenote EPG: incremental grab (triggered by timer every 6h)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# WorkingDirectory must contain config.json (or set GRABBER_CONFIG_PATH)
WorkingDirectory=/var/lib/gracenote-epg
ExecStart=/usr/bin/env gracenote-epg --timer-trigger
# When installed from release archive (no npm -g), use instead:
# ExecStart=/usr/bin/node /opt/gracenote-epg/dist/index.js --timer-trigger
# Optional: User=tvheadend
# Optional: Group=tvheadend
# Optional config path: Environment=GRABBER_CONFIG_PATH=/etc/gracenote-epg/config.json
